APP_NAME=Knowledge Graph RAG
APP_VERSION=0.1.0
APP_DEBUG=false
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_MAX_UPLOAD_SIZE_MB=50
APP_MAX_BATCH_FILES=10
FRONTEND_PORT=3000

POSTGRES_HOST=postgres
POSTGRES_MIGRATION_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLIC_PORT=5432
POSTGRES_USER=change_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=knowledge
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
POSTGRES_ECHO=false

MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=changeme_minio_access_key
MINIO_SECRET_KEY=changeme_minio_secret_key
MINIO_ROOT_USER=changeme_minio_access_key
MINIO_ROOT_PASSWORD=changeme_minio_secret_key
MINIO_BUCKET=documents
MINIO_SECURE=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLIC_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme_redis_password
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

AUTH_SECRET_KEY=changeme_generate_at_least_32_random_characters
AUTH_ALGORITHM=HS256
AUTH_ISSUER=cowo
AUTH_AUDIENCE=cowo-api
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_CLOCK_SKEW_SECONDS=5
AUTH_REFRESH_COOKIE_NAME=cowo_refresh
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REDIS_PREFIX=auth:refresh:

FALKORDB_HOST=falkor
FALKORDB_PORT=6379
FALKORDB_PUBLIC_PORT=6380
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=knowledge_graph_qwen35
FALKORDB_MAX_CONNECTIONS=10
FALKORDB_SOCKET_TIMEOUT=5
FALKORDB_EMBEDDING_DIM=1024

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=change_user
RABBITMQ_DEFAULT_PASS=change_password

LLM_MODEL_EMBEDDING=qwen3-embedding:0.6b

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_ANALYST=llama3.2:3b
LLM_MODEL_RESPONDER=llama3.2:3b
LLM_API_KEY=
LLM_REASONING_EFFORT=none
LLM_SEED=0
LLM_TIMEOUT_SECONDS=600
LLM_MAX_CONCURRENCY=1
LLM_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_EVIDENCE_OUTPUT_TOKENS=512
LLM_RESPONDER_OUTPUT_TOKENS=1024
LLM_COMMUNITY_OUTPUT_TOKENS=384
LLM_MAX_CALLS_PER_DOCUMENT=128
LLM_EMBEDDING_BATCH_SIZE=16
LLM_EMBEDDING_DIMENSIONS=1024

RETRIEVAL_ENTRY_TOP_K=5
RETRIEVAL_MIN_ENTRY_SIMILARITY=0.5
RETRIEVAL_MAX_HOPS=2
RETRIEVAL_BEAM_WIDTH=20
RETRIEVAL_NEIGHBORS_PER_CONCEPT=8
RETRIEVAL_MAX_CARDS=8
RETRIEVAL_PATH_DECAY=0.7

NORMALIZATION_SIMILARITY_THRESHOLD=0.92
NORMALIZATION_CANDIDATES=3

CLUSTERING_ENABLED=true
CLUSTERING_CRON="0 0 * * *"
CLUSTERING_MAX_ITERATIONS=10
CLUSTERING_MIN_COMMUNITY_SIZE=2
CLUSTERING_MAX_COMMUNITIES=50

INGESTION_WORKER_PROCESSES=1
INGESTION_WORKER_CONCURRENCY=2
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_SECONDS=30
INGESTION_LEASE_SECONDS=120
INGESTION_HEARTBEAT_SECONDS=20
INGESTION_JOB_TIMEOUT_SECONDS=1800
INGESTION_PARSE_TIMEOUT_SECONDS=180
INGESTION_MAX_TEXT_CHARS=500000
INGESTION_CLEANUP_ENABLED=true
INGESTION_CLEANUP_GRACE_HOURS=24
INGESTION_CLEANUP_BATCH_SIZE=500
INGESTION_CLEANUP_PREFIX=originals/

LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
