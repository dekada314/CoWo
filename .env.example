APP_NAME=Knowledge Graph RAG
APP_VERSION=0.1.0
APP_DEBUG=false
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_MAX_UPLOAD_SIZE_MB=50

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=change_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=knowledge
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
POSTGRES_ECHO=false

MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=changeme_minio_access_key
MINIO_SECRET_KEY=changeme_minio_secret_key
MINIO_ROOT_USER=changeme_minio_root_user
MINIO_ROOT_PASSWORD=changeme_minio_root_password
MINIO_BUCKET=documents
MINIO_SECURE=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme_redis_password
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

FALKORDB_HOST=falkor
FALKORDB_PORT=6380
FALKORDB_USERNAME=falkor_admin
FALKORDB_PASSWORD=changeme_falkordb_password
FALKORDB_GRAPH_NAME=knowledge_graph
FALKORDB_MAX_CONNECTIONS=10
FALKORDB_SOCKET_TIMEOUT=5
FALKORDB_EMBEDDING_DIM=768
FALKORDB_VECTOR_INDEX_NAME=concept_embedding_idx

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=change_user
RABBITMQ_DEFAULT_PASS=change_password

PARSING_DOCLING_ENABLED=true
